%YAML 1.2
---
# Syntax highlighting for Mar — a friendly Hindley-Milner functional
# language for fullstack apps. See https://mar-lang.dev.
#
# Mar takes its shape from Elm: `module ... exposing (...)` headers,
# custom types with `|`-separated constructors, type aliases for
# records, pattern matching with `case ... of`, lambdas with `\`.
# Lowercase identifiers are values/functions; uppercase identifiers
# are types, constructors, and module names.

name: Mar
file_extensions:
  - mar
scope: source.mar

variables:
  lower_ident: '[a-z][a-zA-Z0-9_]*'
  upper_ident: '[A-Z][a-zA-Z0-9_]*'
  qualified: '{{upper_ident}}(?:\.{{upper_ident}})*'

contexts:
  prototype:
    - include: comments

  main:
    - include: module_declaration
    - include: imports
    - include: type_declarations
    - include: top_level_signatures
    - include: keywords
    - include: literals
    - include: types_and_constructors
    - include: operators
    - include: punctuation

  comments:
    - match: '--.*$'
      scope: comment.line.double-dash.mar
    - match: '\{-'
      scope: punctuation.definition.comment.begin.mar
      push: block_comment

  block_comment:
    - meta_scope: comment.block.mar
    - match: '-\}'
      scope: punctuation.definition.comment.end.mar
      pop: true

  module_declaration:
    - match: '\b(module)\s+({{qualified}})\s+(exposing)\b'
      captures:
        1: keyword.other.module.mar
        2: entity.name.namespace.mar
        3: keyword.other.module.mar

  imports:
    - match: '\b(import)\s+({{qualified}})(?:\s+(as)\s+({{upper_ident}}))?(?:\s+(exposing))?\b'
      captures:
        1: keyword.other.module.mar
        2: entity.name.namespace.mar
        3: keyword.other.module.mar
        4: entity.name.namespace.mar
        5: keyword.other.module.mar

  type_declarations:
    # `type alias Foo = { ... }`
    - match: '\b(type)\s+(alias)\s+({{upper_ident}})'
      captures:
        1: keyword.declaration.type.mar
        2: keyword.declaration.type.mar
        3: entity.name.type.mar
    # `type Foo a b = Bar | Baz ...`
    - match: '\b(type)\s+({{upper_ident}})'
      captures:
        1: keyword.declaration.type.mar
        2: entity.name.type.mar

  top_level_signatures:
    # `name : Type` — function/value signature at column 0.
    - match: '^({{lower_ident}})\s*(:)(?!:)'
      captures:
        1: entity.name.function.mar
        2: keyword.operator.type-annotation.mar
    # `name args = ...` — function/value definition at column 0.
    - match: '^({{lower_ident}})\b'
      captures:
        1: entity.name.function.mar

  keywords:
    - match: '\b(if|then|else)\b'
      scope: keyword.control.conditional.mar
    - match: '\b(case|of)\b'
      scope: keyword.control.case.mar
    - match: '\b(let|in)\b'
      scope: keyword.declaration.binding.mar
    - match: '\b(where|as)\b'
      scope: keyword.other.mar

  literals:
    - include: strings
    - include: chars
    - include: numbers

  strings:
    - match: '"""'
      scope: punctuation.definition.string.begin.mar
      push: triple_quoted_string
    - match: '"'
      scope: punctuation.definition.string.begin.mar
      push: double_quoted_string

  triple_quoted_string:
    - meta_scope: string.quoted.triple.mar
    - match: '\\[\\nrt"]'
      scope: constant.character.escape.mar
    - match: '"""'
      scope: punctuation.definition.string.end.mar
      pop: true

  double_quoted_string:
    - meta_scope: string.quoted.double.mar
    - match: '\\[\\nrt"]'
      scope: constant.character.escape.mar
    - match: '\\u\{[0-9a-fA-F]+\}'
      scope: constant.character.escape.unicode.mar
    - match: '"'
      scope: punctuation.definition.string.end.mar
      pop: true
    - match: '$'
      scope: invalid.illegal.unclosed-string.mar
      pop: true

  chars:
    - match: "'"
      scope: punctuation.definition.string.begin.mar
      push: char_literal

  char_literal:
    - meta_scope: string.quoted.single.mar
    - match: "\\\\[\\\\nrt']"
      scope: constant.character.escape.mar
    - match: "'"
      scope: punctuation.definition.string.end.mar
      pop: true
    - match: '$'
      scope: invalid.illegal.unclosed-char.mar
      pop: true

  numbers:
    - match: '\b\d+\.\d+\b'
      scope: constant.numeric.float.mar
    - match: '\b\d+\b'
      scope: constant.numeric.integer.mar

  types_and_constructors:
    # Qualified access (`UI.text`, `String.fromInt`, etc.). The
    # module prefix scopes as a namespace; the trailing identifier
    # follows the lower/upper rule.
    - match: '\b({{qualified}})\.({{lower_ident}})\b'
      captures:
        1: entity.name.namespace.mar
        2: variable.function.mar
    - match: '\b({{qualified}})\.({{upper_ident}})\b'
      captures:
        1: entity.name.namespace.mar
        2: storage.type.mar
    # Bare upper-case identifier — type or constructor.
    - match: '\b{{upper_ident}}\b'
      scope: storage.type.mar
    # Record-field access (`record.field`).
    - match: '\b({{lower_ident}})\.({{lower_ident}})\b'
      captures:
        1: variable.other.mar
        2: variable.other.member.mar

  operators:
    - match: '->'
      scope: keyword.operator.arrow.mar
    - match: '\|>|<\|'
      scope: keyword.operator.pipe.mar
    - match: '==|/=|<=|>='
      scope: keyword.operator.comparison.mar
    - match: '&&|\|\|'
      scope: keyword.operator.logical.mar
    - match: '\+\+'
      scope: keyword.operator.concat.mar
    - match: '::'
      scope: keyword.operator.cons.mar
    - match: '[+\-*/]'
      scope: keyword.operator.arithmetic.mar
    - match: '='
      scope: keyword.operator.assignment.mar
    - match: '[<>]'
      scope: keyword.operator.comparison.mar
    - match: '\\'
      scope: keyword.operator.lambda.mar
    - match: '\|'
      scope: keyword.operator.alternative.mar

  punctuation:
    - match: '[{}]'
      scope: punctuation.section.braces.mar
    - match: '[\[\]]'
      scope: punctuation.section.brackets.mar
    - match: '[()]'
      scope: punctuation.section.parens.mar
    - match: ','
      scope: punctuation.separator.comma.mar
    - match: ':'
      scope: punctuation.separator.mar
    - match: '\.'
      scope: punctuation.accessor.mar
