{
  "scope": "source.mar",
  "completions": [
    {
      "trigger": "module",
      "annotation": "module declaration",
      "kind": "snippet",
      "contents": "module ${1:Main} exposing (${2:main})\n\n\n$0"
    },
    {
      "trigger": "import",
      "annotation": "import statement",
      "kind": "snippet",
      "contents": "import ${1:Module}${2: exposing (${3:..})}"
    },
    {
      "trigger": "type",
      "annotation": "custom type",
      "kind": "snippet",
      "contents": "type ${1:Name}\n    = ${2:Variant}\n    | ${3:Variant}\n"
    },
    {
      "trigger": "typealias",
      "annotation": "type alias (record)",
      "kind": "snippet",
      "contents": "type alias ${1:Name} =\n    { ${2:field} : ${3:Type}\n    }\n"
    },
    {
      "trigger": "case",
      "annotation": "case expression",
      "kind": "snippet",
      "contents": "case ${1:expr} of\n    ${2:pattern} ->\n        $0\n\n    _ ->\n        ${3:fallback}"
    },
    {
      "trigger": "if",
      "annotation": "if/then/else",
      "kind": "snippet",
      "contents": "if ${1:condition} then\n    $2\nelse\n    $3"
    },
    {
      "trigger": "let",
      "annotation": "let binding",
      "kind": "snippet",
      "contents": "let\n    ${1:name} =\n        ${2:expr}\nin\n$0"
    },
    {
      "trigger": "fn",
      "annotation": "top-level function",
      "kind": "snippet",
      "contents": "${1:name} : ${2:Args -> Return}\n${1:name} ${3:args} =\n    $0"
    },
    {
      "trigger": "page",
      "annotation": "MVU page",
      "kind": "snippet",
      "contents": "type alias Model = ${1:()}\n\n\ntype Msg\n    = ${2:NoOp}\n\n\ninit : (Model, Cmd Msg)\ninit =\n    (${3:()}, Cmd.none)\n\n\nupdate : Msg -> Model -> (Model, Cmd Msg)\nupdate msg model =\n    case msg of\n        ${2:NoOp} ->\n            (model, Cmd.none)\n\n\nsubscriptions : Model -> Sub Msg\nsubscriptions model =\n    Sub.none\n\n\nview : Model -> View Msg\nview model =\n    $0\n\n\npage : Page\npage =\n    Page.create\n        { path = \"${4:/}\"\n        , title = \"${5:Title}\"\n        , init = init\n        , update = update\n        , view = view\n        , subscriptions = subscriptions\n        }"
    },
    {
      "trigger": "entity",
      "annotation": "Entity definition",
      "kind": "snippet",
      "contents": "${1:items} : Entity ${2:Item}\n${1:items} =\n    Entity.define\n        { name = \"${1:items}\"\n        , columns =\n            { id   = Entity.serial\n            , ${3:name} = Entity.text Entity.notNull\n            }\n        , uniques = []\n        }"
    },
    {
      "trigger": "service",
      "annotation": "Service contract",
      "kind": "snippet",
      "contents": "${1:listItems} : Service ${2:()} ${3:(List Item)}\n${1:listItems} = Service.declare ${4:GET} \"${5:/items}\""
    },
    {
      "trigger": "fullstack",
      "annotation": "App.fullstack main",
      "kind": "snippet",
      "contents": "main : Cmd ()\nmain =\n    App.fullstack\n        { services = ${1:Backend.services}\n        , pages    = [ ${2:Frontend.page} ]\n        }"
    },
    {
      "trigger": "frontend",
      "annotation": "App.frontend main",
      "kind": "snippet",
      "contents": "main : Cmd ()\nmain =\n    App.frontend [ ${1:page} ]"
    },
    {
      "trigger": "auth",
      "annotation": "Auth.config",
      "kind": "snippet",
      "contents": "auth : Auth { id : Int, email : String }\nauth =\n    Auth.config\n        { entity     = ${1:Backend.users}\n        , identify   = \\u -> u.email\n        , signInPage = ${2:Frontend.SignIn.page}\n        , email      = { subject = \"${3:Sign in}\" }\n        , signup     = \\email -> { email = email }\n        , sessionDuration = Time.days 30\n        }"
    },
    {
      "trigger": "navstack",
      "annotation": "navigationStack",
      "kind": "snippet",
      "contents": "navigationStack [ navigationTitle \"${1:Title}\" ]\n    [ ${2:list []}\n        [ ${3:section [] [ text [] \"${4:Hello}\" ]}\n        ]\n    ]"
    },
    {
      "trigger": "list",
      "annotation": "UI list with section",
      "kind": "snippet",
      "contents": "list []\n    [ section []\n        [ $0 ]\n    ]"
    },
    {
      "trigger": "section",
      "annotation": "UI section",
      "kind": "snippet",
      "contents": "section []\n    [ $0 ]"
    },
    {
      "trigger": "button",
      "annotation": "UI button",
      "kind": "snippet",
      "contents": "button [] ${1:Msg} \"${2:Label}\""
    },
    {
      "trigger": "textField",
      "annotation": "UI textField",
      "kind": "snippet",
      "contents": "textField [ submit ${1:Msg} ] \"${2:Placeholder}\" ${3:model.draft} ${4:DraftChanged}"
    },
    {
      "trigger": "navlink",
      "annotation": "UI navigationLink",
      "kind": "snippet",
      "contents": "navigationLink [] ${1:Routes.target} ${2:{}} (text [] \"${3:Label}\")"
    },
    {
      "trigger": "scall",
      "annotation": "Service.call",
      "kind": "snippet",
      "contents": "Service.call ${1:Shared.listItems} ${2:()} ${3:ItemsLoaded}"
    },
    {
      "trigger": "lambda",
      "annotation": "lambda expression",
      "kind": "snippet",
      "contents": "\\\\${1:x} -> ${2:expr}"
    },
    {
      "trigger": "path",
      "annotation": "typed path",
      "kind": "snippet",
      "contents": "${1:home} : Path ${2:{}}\n${1:home} = \"${3:/}\""
    },
    {
      "trigger": "maybe",
      "annotation": "case Maybe",
      "kind": "snippet",
      "contents": "case ${1:maybeValue} of\n    Just ${2:value} ->\n        $0\n\n    Nothing ->\n        ${3:fallback}"
    },
    {
      "trigger": "result",
      "annotation": "case Result",
      "kind": "snippet",
      "contents": "case ${1:result} of\n    Ok ${2:value} ->\n        $0\n\n    Err ${3:err} ->\n        ${4:fallback}"
    },
    {
      "trigger": "page-protected",
      "annotation": "Page.protected (auth-gated)",
      "kind": "snippet",
      "contents": "page : Page\npage =\n    Page.protected\n        { path = \"${1:/}\"\n        , title = \"${2:Title}\"\n        , init = init\n        , update = update\n        , view = view\n        , subscriptions = subscriptions\n        }"
    }
  ]
}
